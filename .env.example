# Copy this file to .env and fill in the values. Never commit .env.
# The backend loads dfi/.env at startup; real shell variables take precedence.

# Required for Gemini name resolution. Leave empty to fall back to PubChem only.
GEMINI_API_KEY=

# Optional. Defaults to gemini-flash-lite-latest.
GEMINI_MODEL=gemini-flash-lite-latest

# Set to 0 to disable all outbound resolver calls (local database and user SMILES only).
DFI_ONLINE_RESOLVER=1
